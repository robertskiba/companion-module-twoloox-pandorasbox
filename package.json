{
  "name": "companion-module-twoloox-pandorasbox",
  "version": "3.1.0-beta.1",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "build": "rimraf dist && yarn build:main",
    "build:main": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "lint:raw": "eslint",
    "lint": "run lint:raw .",
    "dist": "yarn companion-module-build"
  },
  "license": "MIT",
  "prettier": "@companion-module/tools/.prettierrc.json",
  "lint-staged": {
    "*.{css,json,md,scss}": [
      "run prettier --write"
    ],
    "*.{ts,tsx,js,jsx}": [
      "run lint:raw --fix"
    ]
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@companion-module/base": "~2.1.3"
  },
  "devDependencies": {
    "@companion-module/tools": "^3.1.0",
    "@types/node": "^22.15.21",
    "eslint": "^9.39.3",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "prettier": "^3.8.1",
    "rimraf": "^6.0.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.56.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bitfocus/companion-module-twoloox-pandorasbox.git"
  },
  "packageManager": "yarn@4.13.0"
}
